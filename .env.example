# Copy to .env and edit. .env is git-ignored. Everything here is optional.
# run.sh loads .env if present (it never overwrites variables already set in your shell).

# --- server (localhost only by default) ---
# ATLAS_HOST=127.0.0.1
# ATLAS_PORT=8765
# ATLAS_DATA_DIR=./data

# --- local model: any OpenAI-compatible server (Ollama, llama.cpp, LM Studio, ...) ---
# Ollama:    http://127.0.0.1:11434/v1      llama.cpp server: http://127.0.0.1:8080/v1
ATLAS_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
# ATLAS_LOCAL_MODEL=

# --- optional online providers (API keys are billed separately from chat subscriptions) ---
# Also requires: Settings -> "Allow external AI providers"
# OPENAI_API_KEY=
# BRAVE_API_KEY=
